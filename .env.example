# Copie este arquivo para ".env" e preencha com suas chaves.
# Você só precisa preencher a chave dos modelos que quiser usar.
# Se deixar em branco, o card daquele modelo só vai avisar que a chave não foi configurada.

# APIs pagas (clientes oficiais)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# APIs gratuitas/alternativas
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Nomes dos modelos usados em cada API.
# Esses são os modelos mais atuais no momento em que este projeto foi montado (agosto/2026).
# Como cada empresa lança modelos novos com frequência, se algum parar de funcionar,
# troque o valor abaixo pelo nome atual (veja o README para onde checar).
CLAUDE_MODEL=claude-sonnet-5
GPT_MODEL=gpt-5.5
GEMINI_MODEL=gemini-3.1-pro
GROK_MODEL=grok-4.5
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama roda 100% local na sua máquina, não precisa de chave.
# Instale em https://ollama.com/download, rode "ollama pull llama3.2" (ou outro modelo),
# e deixe o Ollama aberto — ele sobe o servidor local automaticamente em localhost:11434.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
